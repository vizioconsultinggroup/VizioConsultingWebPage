---
import { siteConfig } from '../data/site';
interface Props { showMobileCta?: boolean; }
const { showMobileCta = true } = Astro.props;
---
<footer><div class="footer-main"><div class="footer-brand"><div class="footer-wordmark">VIZIO<small>CONSULTING GROUP</small></div><p>Átlátható pénzügyi lehetőségek, személyes figyelemmel és hosszú távú szemlélettel.</p></div><div><h3>Szolgáltatások</h3><a href="/bankszamla">Bankszámla</a><a href="/megtakaritas">Megtakarítás</a><a href="/hitelek">Hitelek</a><a href="/okoshitel">Okoshitel</a><a href="/otthonteremtes">Otthonteremtés</a><a href="/biztositas">Biztosítás</a><a href="/nyugdij">Nyugdíj</a></div><div><h3>Jogi információk</h3><a href="/impresszum">Impresszum</a><a href="/adatkezeles">Adatkezelési tájékoztató</a><a href="/cookie">Cookie tájékoztató</a><a href="/jogi-nyilatkozat">Jogi nyilatkozat</a></div><div><h3>Kapcsolat</h3><a href={`mailto:${siteConfig.email}`} data-event="email_click">{siteConfig.email}</a><a href="tel:+36202874336" data-event="phone_click">{siteConfig.phone}</a>{siteConfig.googleBusinessUrl && <a href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">Megnézem Google-on</a>}</div></div><div class="footer-bottom"><span>© 2026 Vizio Consulting Group. Minden jog fenntartva.</span><div>{siteConfig.facebook && <a href={siteConfig.facebook}>Facebook</a>}{siteConfig.instagram && <a href={siteConfig.instagram}>Instagram</a>}{siteConfig.linkedin && <a href={siteConfig.linkedin}>LinkedIn</a>}</div></div></footer>
{showMobileCta && <a class="mobile-cta" href="/#idopont" data-event="booking_click">Időpontfoglalás</a>}
