---
import { siteConfig } from '../data/site';
interface Props { showMobileCta?: boolean; }
const { showMobileCta = true } = Astro.props;
const socialLinks = [
  ['Facebook',siteConfig.facebook],
  ['Instagram',siteConfig.instagram],
  ['LinkedIn',siteConfig.linkedin],
  ['TikTok',siteConfig.tiktok],
].filter((entry): entry is [string,string] => Boolean(entry[1]));
---
<footer>
  <div class="footer-main">
    <div class="footer-brand">
      <div class="footer-wordmark">VIZIO<small>CONSULTING</small></div>
      <p>Átlátható pénzügyi lehetőségek, személyes figyelemmel és hosszú távú szemlélettel.</p>
    </div>
    <div><h3>Szolgáltatások</h3><a href="/bankszamla">Bankszámla</a><a href="/megtakaritas">Megtakarítás</a><a href="/hitelek">Hitelek</a><a href="/okoshitel">Okoshitel</a><a href="/otthonteremtes">Otthonteremtés</a><a href="/biztositas">Biztosítás</a><a href="/nyugdij">Nyugdíj</a></div>
    <div><h3>Jogi információk</h3><a href="/impresszum">Impresszum</a><a href="/adatkezeles">Adatkezelési tájékoztató</a><a href="/cookie">Cookie tájékoztató</a><a href="/netikett">Netikett</a><a href="/jogi-nyilatkozat">Jogi nyilatkozat</a></div>
    <div><h3>Kapcsolat</h3><a href={`mailto:${siteConfig.email}`} data-event="email_click">{siteConfig.email}</a>{siteConfig.phone && <a href={`tel:${siteConfig.phoneHref}`} data-event="phone_click">{siteConfig.phone}</a>}{siteConfig.googleBusinessUrl && <a href={siteConfig.googleBusinessUrl} target="_blank" rel="noreferrer">Megnézem Google-on</a>}</div>
  </div>
  <div class="footer-disclosures">
    <p><strong>{siteConfig.brandName} – {siteConfig.operatorName}</strong><br/>{siteConfig.intermediaryType}. A közvetítői tevékenység az {siteConfig.intermediaryOrganization}-hez kapcsolódóan történik. MNB nyilvántartási szám: <a href={siteConfig.mnbIntermediaryRegisterUrl} target="_blank" rel="noreferrer">{siteConfig.mnbRegistrationNumber}</a>.</p>
    <p>A weboldalon található információk általános tájékoztatási célt szolgálnak, és önmagukban nem minősülnek személyre szabott pénzügyi, biztosítási, hitel- vagy befektetési ajánlatnak. Az egyes pénzügyi termékek feltételei és elérhetősége szolgáltatónként, valamint az ügyfél egyedi körülményei alapján eltérhetnek.</p>
    {siteConfig.showOvbLogo && siteConfig.ovbLogoUrl && <img src={siteConfig.ovbLogoUrl} alt="OVB" loading="lazy" />}
  </div>
  <div class="footer-bottom"><span>© 2026 {siteConfig.brandName}. Minden jog fenntartva.</span>{socialLinks.length > 0 && <div>{socialLinks.map(([label,url])=><a href={url} target="_blank" rel="noreferrer">{label}</a>)}</div>}</div>
</footer>
{showMobileCta && <a class="mobile-cta" href="/#idopont" data-event="booking_click">Időpontfoglalás</a>}
