---
import { services } from '../data/services';
import { team } from '../data/team';
import { siteConfig } from '../data/site';
import ContactForm from './ContactForm.astro';
const benefits = [['Átlátható lehetőségek','A pénzügyi döntések könnyebben összehasonlíthatóvá válnak.'],['Széles szolgáltatási kör','Bankszámlától a hosszú távú megtakarításokig.'],['Egy helyen','Több pénzügyi terület egy kapcsolattartási ponton keresztül.'],['Hosszú távú szemlélet','A jelenlegi döntések mellett a későbbi célokat is figyelembe vesszük.']];
const insurance = [['Lakásbiztosítás','Otthon és vagyontárgyak védelme.'],['KGFB','Kötelező gépjármű-felelősségbiztosítás.'],['Casco','Saját gépjármű védelme.'],['Utasbiztosítás','Védelem külföldi utazásokhoz.'],['Élet- és balesetbiztosítás','Pénzügyi védelem váratlan élethelyzetekben.']];
const smart = [['Rövidebb futamidő','Megfelelő feltételek mellett a hitel a tervezettnél korábban lezárható lehet.'],['Alacsonyabb teljes kamatteher','A rövidebb tényleges futamidő kamatmegtakarítást eredményezhet.'],['Előtörlesztési lehetőség','A hitel hosszú távú optimalizálásában az előtörlesztés is szerepet kaphat.'],['Tudatos pénzügyi stratégia','A hitel kezelése hosszabb távú pénzügyi tervezésbe illeszthető.']];
const bookingHref = siteConfig.bookingUrl || '#kapcsolat';
---
<section class="section about" id="rolunk">
  <div class="section-label reveal">01 / Rólunk</div>
  <div class="about-grid"><div class="reveal"><p class="kicker">A Vizio mögött</p><h2>Figyelem a jelenre.<br /><em>Gondolkodás a jövőről.</em></h2></div><div class="about-copy reveal"><p class="intro">A VIZIO Consulting célja, hogy átláthatóbbá és egyszerűbbé tegye a pénzügyi lehetőségek világát.</p><p>Több pénzügyi területet fogunk össze egy helyen, hogy a különböző élethelyzetekhez releváns megoldások közül lehessen választani. Munkánk alapja az átláthatóság, a tudatosság, az ügyfélközpontúság, a hosszú távú gondolkodás és a professzionális ügyfélélmény.</p><div class="signature-line">VIZIO <span>Consulting</span></div></div></div>
</section>

<section class="section services-section" id="szolgaltatasok">
  <div class="section-heading reveal"><div><p class="kicker">Szolgáltatások</p><h2>Pénzügyi lehetőségek,<br /><em>átláthatóan.</em></h2></div><p>Az élethelyzetedhez és céljaidhoz illeszkedő területeket egy helyen tekintheted át.</p></div>
  <div class="service-grid">{services.map((service)=><article class:list={['service-card','reveal',{'service-card-featured':service.featured}]}><span class="card-number">{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.points.map(point=><li>{point}</li>)}</ul><a href={`/${service.slug}`} data-event={service.event}>{service.cta} <span>↗</span></a></article>)}</div>
</section>

<section class="smart-loan" id="okoshitel">
  <div class="smart-intro reveal"><p class="kicker light">Kiemelt szolgáltatás</p><h2>Okosabban a<br /><em>meglévő hitellel.</em></h2><p>Egy tudatosan felépített pénzügyi stratégia megfelelő körülmények között csökkentheti a hitel tényleges futamidejét és teljes kamatterhét.</p><div class="actions"><a class="button" href="/okoshitel" data-event="okoshitel_cta">Kérek Okoshitel számítást</a><a class="text-link" href="/okoshitel" data-event="okoshitel_cta">Megnézem, nálam mit jelenthet →</a></div></div>
  <div class="smart-grid">{smart.map(([title,text],i)=><article class="reveal"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  <p class="disclaimer">A konkrét eredmény minden esetben az egyedi hitelszerződés, az előtörlesztési feltételek, a választott pénzügyi megoldások és egyéb körülmények függvénye. Az információk nem jelentenek garantált megtakarítást.</p>
</section>

<section class="section split-feature">
  <div class="feature-art reveal"><div class="house-lines"><span></span></div><p>Otthon. Biztonság. Jövő.</p></div>
  <div class="feature-copy reveal"><p class="kicker">Otthonteremtés</p><h2>Az otthonhoz vezető út <em>átláthatóbban.</em></h2><p>Lakásvásárlásnál több finanszírozási lehetőség és támogatás is szóba jöhet. Segítünk átláthatóvá tenni az aktuálisan elérhető lehetőségeket.</p><div class="tag-list"><span>Lakáshitel</span><span>Első lakás</span><span>Támogatott hitelek</span><span>CSOK Plusz</span><span>Babaváró</span></div><a class="arrow-link" href="/otthonteremtes" data-event="otthonteremtes_cta">Otthonteremtési lehetőségek →</a></div>
</section>

<section class="section insurance-section">
  <div class="section-heading reveal"><div><p class="kicker">Biztosítások</p><h2>Biztonság a váratlan<br /><em>helyzetekre.</em></h2></div><p>A mindennapok, az otthon és a család pénzügyi védelméhez kialakítható lehetőségek.</p></div>
  <div class="insurance-list">{insurance.map(([title,text],i)=><article class="reveal"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p><a href="/biztositas" data-event="biztositas_cta" aria-label={`${title} – érdeklődés`}>→</a></article>)}</div><a class="button outline-button" href="/biztositas" data-event="biztositas_cta">Biztosítási lehetőségek</a>
</section>

<section class="future-section"><div class="future-copy reveal"><p class="kicker light">Nyugdíj és megtakarítás</p><h2>A jövő pénzügyi biztonsága <em>ma kezdődik.</em></h2><p>A hosszú távú vagyonépítés és nyugdíjcélú megtakarítás annál hatékonyabb lehet, minél korábban kezdődik.</p><a class="button" href="/nyugdij" data-event="nyugdij_cta">Hosszú távú lehetőségek</a></div><div class="future-points">{['Hosszú távú vagyonépítés','Rendszeres megtakarítás','Nyugdíjcél','Pénzügyi tartalék'].map((x,i)=><div class="reveal"><span>{i+1}</span><p>{x}</p></div>)}</div></section>

<section class="section team-section" id="csapat"><div class="section-heading reveal"><div><p class="kicker">Csapat</p><h2>Akik a Vizio mögött <em>állnak.</em></h2></div><p>Emberi figyelem, tiszta kommunikáció és hosszú távú szemlélet minden ügyfélkapcsolatban.</p></div><div class="team-grid">{team.map((member,i)=><article class:list={['team-card','reveal',{'team-card-placeholder':member.placeholder}]}>{member.placeholder ? <><div class="portrait-placeholder" aria-hidden="true"><span>V</span><small>{String(i+1).padStart(2,'0')}</small></div><h3>További bemutatkozás helye</h3><p class="role">A csapat adatainak bővítésekor frissül</p></> : <><div class="portrait-placeholder" role="img" aria-label={member.image}><span>V</span><small>{String(i+1).padStart(2,'0')}</small></div><h3>{member.name}</h3><p class="role">{member.role}</p><p>{member.bio}</p>{member.businessName && <p class="team-legal">{member.businessName}{member.mnbRegistration && <> · MNB: {member.mnbRegistration}</>}</p>}<div class="team-links">{member.email && <a href={`mailto:${member.email}`} data-event="email_click">E-mail</a>}{member.linkedin && <a href={member.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>}</div></>}</article>)}</div></section>

<section class="section benefits-section"><div class="section-heading reveal"><div><p class="kicker">Miért Vizio?</p><h2>Magabiztosabb döntések.<br /><em>Tisztább kép.</em></h2></div></div><div class="benefit-grid">{benefits.map(([title,text],i)=><article class="reveal"><span>✦</span><small>0{i+1}</small><h3>{title}</h3><p>{text}</p></article>)}</div></section>

<section class="booking" id="idopont"><div class="booking-mark" aria-hidden="true">V</div><div class="reveal"><p class="kicker light">Személyes konzultáció</p><h2>Beszéljük át a <em>lehetőségeidet.</em></h2><p>Foglalj egy számodra megfelelő időpontot.</p><a class="button" href={bookingHref} data-event="booking_click">Időpontot foglalok</a></div></section>

<section class="section contact-section" id="kapcsolat"><div class="contact-info reveal"><p class="kicker">Kapcsolat</p><h2>Kezdjünk egy <em>beszélgetéssel.</em></h2><p><strong>{siteConfig.brandName}</strong><br/>Írj nekünk, és felvesszük veled a kapcsolatot.</p><dl><div><dt>E-mail</dt><dd><a href={`mailto:${siteConfig.email}`} data-event="email_click">{siteConfig.email}</a></dd></div>{siteConfig.phone && <div><dt>Telefon</dt><dd><a href={`tel:${siteConfig.phoneHref}`} data-event="phone_click">{siteConfig.phone}</a></dd></div>}{siteConfig.address && <div><dt>Cím</dt><dd>{siteConfig.address}</dd></div>}</dl></div>
  <ContactForm />
</section>
