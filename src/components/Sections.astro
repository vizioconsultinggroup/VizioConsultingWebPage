---
import { services } from '../data/services';
import { team } from '../data/team';
import { siteConfig } from '../data/site';
const benefits = [['Átlátható lehetőségek','A pénzügyi döntések könnyebben összehasonlíthatóvá válnak.'],['Széles szolgáltatási kör','Bankszámlától a hosszú távú megtakarításokig.'],['Egy helyen','Több pénzügyi terület egy kapcsolattartási ponton keresztül.'],['Hosszú távú szemlélet','A jelenlegi döntések mellett a későbbi célokat is figyelembe vesszük.']];
const insurance = [['Lakásbiztosítás','Otthon és vagyontárgyak védelme.'],['KGFB','Kötelező gépjármű-felelősségbiztosítás.'],['Casco','Saját gépjármű védelme.'],['Utasbiztosítás','Védelem külföldi utazásokhoz.'],['Élet- és balesetbiztosítás','Pénzügyi védelem váratlan élethelyzetekben.']];
const smart = [['Rövidebb futamidő','Megfelelő stratégia mellett évekkel hamarabb lezárható lehet a hitel.'],['Kevesebb kamatteher','A rövidebb tényleges futamidő jelentős kamatmegtakarítást eredményezhet.'],['Tervezett előtörlesztés','A hitel nem feltétlenül csak a havi törlesztőrészletekkel csökkenthető.'],['Tudatos vagyonépítés','A hitel visszafizetése mellett hosszabb távú pénzügyi tartalék is építhető.']];
const bookingHref = siteConfig.bookingUrl || '#kapcsolat';
---
<section class="section about" id="rolunk">
  <div class="section-label reveal">01 / Rólunk</div>
  <div class="about-grid"><div class="reveal"><p class="kicker">A Vizio mögött</p><h2>Figyelem a jelenre.<br /><em>Gondolkodás a jövőről.</em></h2></div><div class="about-copy reveal"><p class="intro">A Vizio Consulting Group célja, hogy ügyfelei számára átláthatóbbá és egyszerűbbé tegye a pénzügyi lehetőségek világát.</p><p>Több pénzügyi területet fogunk össze egy helyen, hogy a különböző élethelyzetekhez megfelelő megoldások közül lehessen választani. Ügyfélközpontú szemléletünk alapja a tiszta kommunikáció, a pénzügyi tudatosság és a hosszú távú gondolkodás.</p><div class="signature-line">VIZIO <span>Consulting Group</span></div></div></div>
</section>

<section class="section services-section" id="szolgaltatasok">
  <div class="section-heading reveal"><div><p class="kicker">Szolgáltatások</p><h2>Pénzügyi lehetőségek,<br /><em>átláthatóan.</em></h2></div><p>Az élethelyzetedhez és céljaidhoz illeszkedő területeket egy helyen tekintheted át.</p></div>
  <div class="service-grid">{services.map((service)=><article class="service-card reveal"><span class="card-number">{service.number}</span><h3>{service.title}</h3><p>{service.text}</p><ul>{service.points.map(point=><li>{point}</li>)}</ul><a href="#kapcsolat">{service.cta} <span>↗</span></a></article>)}</div>
</section>

<section class="smart-loan" id="okoshitel">
  <div class="smart-intro reveal"><p class="kicker light">Kiemelt szolgáltatás</p><h2>Okosabban a<br /><em>meglévő hitellel.</em></h2><p>Egy tudatosan felépített pénzügyi stratégia segítségével a meglévő hitel hosszú távon hatékonyabban kezelhető.</p><div class="actions"><a class="button" href="#kapcsolat">Kérek Okoshitel számítást</a><a class="text-link" href="#kapcsolat">Megnézem, nekem mennyit jelenthet →</a></div></div>
  <div class="smart-grid">{smart.map(([title,text],i)=><article class="reveal"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
  <p class="disclaimer">A konkrét eredmény minden esetben egyedi számítástól és a választott pénzügyi konstrukciók feltételeitől függ.</p>
</section>

<section class="section split-feature">
  <div class="feature-art reveal"><div class="house-lines"><span></span></div><p>Otthon. Biztonság. Jövő.</p></div>
  <div class="feature-copy reveal"><p class="kicker">Otthonteremtés</p><h2>Az otthonhoz vezető út <em>átláthatóbban.</em></h2><p>Lakásvásárlásnál több finanszírozási lehetőség és támogatás is szóba jöhet. Segítünk átláthatóvá tenni az aktuálisan elérhető lehetőségeket.</p><div class="tag-list"><span>Lakáshitel</span><span>Első lakás</span><span>Támogatott hitelek</span><span>CSOK Plusz</span><span>Babaváró</span></div><a class="arrow-link" href="#kapcsolat">Otthonteremtési lehetőségek →</a></div>
</section>

<section class="section insurance-section">
  <div class="section-heading reveal"><div><p class="kicker">Biztosítások</p><h2>Biztonság a váratlan<br /><em>helyzetekre.</em></h2></div><p>A mindennapok, az otthon és a család pénzügyi védelméhez kialakítható lehetőségek.</p></div>
  <div class="insurance-list">{insurance.map(([title,text],i)=><article class="reveal"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p><a href="#kapcsolat" aria-label={`${title} – érdeklődés`}>→</a></article>)}</div><a class="button outline-button" href="#kapcsolat">Biztosítási lehetőségek</a>
</section>

<section class="future-section"><div class="future-copy reveal"><p class="kicker light">Nyugdíj és megtakarítás</p><h2>A jövő pénzügyi biztonsága <em>ma kezdődik.</em></h2><p>A hosszú távú vagyonépítés és nyugdíjcélú megtakarítás annál hatékonyabb lehet, minél korábban kezdődik.</p><a class="button" href="#kapcsolat">Hosszú távú lehetőségek</a></div><div class="future-points">{['Hosszú távú vagyonépítés','Rendszeres megtakarítás','Nyugdíjcél','Pénzügyi tartalék'].map((x,i)=><div class="reveal"><span>{i+1}</span><p>{x}</p></div>)}</div></section>

<section class="section team-section" id="csapat"><div class="section-heading reveal"><div><p class="kicker">Csapat</p><h2>Akik a Vizio mögött <em>állnak.</em></h2></div><p>Két ember, közös értékekkel: őszinte figyelem, emberi kapcsolódás és elkötelezettség minden ügyfél története iránt.</p></div><div class="team-grid">{team.map((member,i)=><article class="team-card reveal"><div class="portrait-placeholder" role="img" aria-label={member.image}><span>V</span><small>{String(i+1).padStart(2,'0')}</small></div><h3>{member.name}</h3><p class="role">{member.role}</p><p>{member.bio}</p></article>)}</div></section>

<section class="section benefits-section"><div class="section-heading reveal"><div><p class="kicker">Miért Vizio?</p><h2>Magabiztosabb döntések.<br /><em>Tisztább kép.</em></h2></div></div><div class="benefit-grid">{benefits.map(([title,text],i)=><article class="reveal"><span>✦</span><small>0{i+1}</small><h3>{title}</h3><p>{text}</p></article>)}</div></section>

<section class="booking" id="idopont"><div class="booking-mark" aria-hidden="true">V</div><div class="reveal"><p class="kicker light">Személyes konzultáció</p><h2>Beszéljük át a <em>lehetőségeidet.</em></h2><p>Foglalj egy számodra megfelelő időpontot.</p><a class="button" href={bookingHref}>Időpontot foglalok</a></div></section>

<section class="section contact-section" id="kapcsolat"><div class="contact-info reveal"><p class="kicker">Kapcsolat</p><h2>Kezdjünk egy <em>beszélgetéssel.</em></h2><p>Írj nekünk, és felvesszük veled a kapcsolatot.</p><dl><div><dt>E-mail</dt><dd><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></dd></div><div><dt>Telefon</dt><dd><a href="tel:+36202874336">{siteConfig.phone}</a></dd></div></dl></div>
  <form class="contact-form reveal" action={`mailto:${siteConfig.email}`} method="post" enctype="text/plain"><div class="field-row"><label>Név<input required name="nev" autocomplete="name" /></label><label>E-mail<input required type="email" name="email" autocomplete="email" /></label></div><div class="field-row"><label>Telefonszám<input type="tel" name="telefon" autocomplete="tel" /></label><label>Érdeklődési terület<select name="terulet" required><option value="">Válassz területet</option>{['Bankszámla','Megtakarítás','Hitel','Okoshitel','Otthonteremtés','Biztosítás','Nyugdíj','Egyéb'].map(x=><option>{x}</option>)}</select></label></div><label>Üzenet<textarea name="uzenet" rows="4" required></textarea></label><label class="checkbox"><input type="checkbox" required /><span>Elfogadom az <a href="/adatkezeles">adatkezelési tájékoztatót</a>.</span></label><button class="button" type="submit">Üzenet küldése</button><p class="form-note">Az üzenet az eszközöd levelezőprogramjában nyílik meg. Közvetlen űrlap-integráció a központi konfigurációból csatlakoztatható.</p></form>
</section>
