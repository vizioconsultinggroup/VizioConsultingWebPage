---
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<Layout title={`${title} | Vizio Consulting Group`} description={description}>
  <header class="legal-header"><a class="brand" href="/"><span><b>VIZIO</b><small>CONSULTING GROUP</small></span></a><a href="/">← Vissza a főoldalra</a></header>
  <main class="legal-page"><p class="kicker">Jogi információk</p><h1>{title}</h1><slot /></main><Footer />
</Layout>
